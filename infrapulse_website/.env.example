# =================================================================
# InfraPulse - Unified Production Environment Variables
# Copy to .env: cp .env.example .env
# =================================================================

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=infrapulse_secure_password_2026
POSTGRES_DB=infrapulse

# Application Security
# Generate random 64-char key with: openssl rand -hex 32
JWT_SECRET=super_secret_production_jwt_key_infrapulse_2026

# Allowed Frontend Origins for CORS (defaults to all)
FRONTEND_ORIGIN=*
