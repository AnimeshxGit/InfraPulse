# InfraPulse Backend Environment Configuration

# Application
PROJECT_NAME="InfraPulse Backend"
API_V1_STR="/api/v1"

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/infrapulse"
# SQLite development URL:
# DATABASE_URL="sqlite+aiosqlite:///./infrapulse.db"

# Redis
REDIS_URL="redis://localhost:6379/0"
REDIS_AI_EVENT_CHANNEL="infrapulse.ai.events.v1"
REDIS_WS_CHANNEL="infrapulse.ws.events.v1"

# Celery
CELERY_AI_QUEUE="inference"
CELERY_TASK_NAME="app.tasks.process_complaint"
AI_PIPELINE_VERSION="v1"

# JWT Security
JWT_SECRET="replace-with-a-secure-random-secret-key-for-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Storage
STORAGE_BACKEND="local"
STORAGE_ROOT="./uploads"
MAX_UPLOAD_SIZE_BYTES=10485760

# Frontend Origins
FRONTEND_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
